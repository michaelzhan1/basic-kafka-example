{
    "name": "C++ Environment",
    "dockerComposeFile": "../compose.yaml",
    "service": "dev",
    "runServices": [
        "dev"
    ],
    "mounts": [
        "type=bind,source=/home/${localEnv:USER}/.ssh,target=/root/.ssh,readonly"
    ],
    "workspaceFolder": "/app",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools"
            ]
        }
    }
}